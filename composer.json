{
    "name": "azine/hybridauth-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle to access profiles via Xing and LinkedIn APIs using HybridAuth",
    "keywords": [
        "xing",
        "oauth",
        "xing api"
    ],
    "homepage": "https://github.com/azine/AzineHybridAuthBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Azine IT Services AG",
            "email": "github@azine-it.ch"
        }
    ],
    "config": {
        "process-timeout": 590,
        "github-protocols": [
            "https",
            "git",
            "ssh"
        ],
        "github-domains": [
            "github.com"
        ],
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "require": {
        "php": "^8.5",
        "symfony/framework-bundle": "^7.4",
        "symfony/console": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/security-bundle": "^7.4",
        "hybridauth/hybridauth": "^3.13",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Azine\\HybridAuthBundle\\": ""
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Azine\\HybridAuthBundle\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    }
}
